{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"]
    },
    "babylon-nme": {
      "command": "npx",
      "args": ["-y", "@babylonjs/mcp-servers", "nme"]
    },
    "babylon-npe": {
      "command": "npx",
      "args": ["-y", "@babylonjs/mcp-servers", "npe"]
    },
    "babylon-gui": {
      "command": "npx",
      "args": ["-y", "@babylonjs/mcp-servers", "gui"]
    },
    "meshy": {
      "command": "npx",
      "args": ["-y", "@meshy-ai/meshy-mcp-server"],
      "env": { "MESHY_API_KEY": "${MESHY_API_KEY}" }
    }
  }
}
