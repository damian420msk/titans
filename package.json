{
    "name": "titans-throws",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node tools/dev.mjs",
        "dev:client": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "dev:server": "node --experimental-strip-types server/index.ts",
        "build": "tsc --noEmit && vite build",
        "check": "tsc --noEmit && node --experimental-strip-types --test tests/world.test.ts tests/network.test.ts tests/local-clock.test.ts && playwright test"
    },
    "dependencies": {
        "@babylonjs/core": "^9.32.0",
        "@babylonjs/loaders": "9.32.0",
        "@colyseus/core": "0.18.23",
        "@colyseus/schema": "5.0.42",
        "@colyseus/sdk": "0.18.6",
        "@colyseus/ws-transport": "0.18.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
}
